{
  "_repro": {"paper": "Multi-language robustness of LLM code generation (EMSE 2026)", "src_dirs": "run_code", "hash_dirs": "run_code datasets/nominal",
             "modules": "StdEnv/2023 python/3.11 java/17.0.6 nodejs/20.16.0"},
  "project": "r_robust",
  "require_gpu": true,
  "vars": {"MAX_FORMAT_FILES": "1000"},
  "smoke": {"vars": {"MAX_FORMAT_FILES": "5"}, "time": "00:55:00", "matrix_limit": 1},
  "stages": [
    {"name": "setup", "description": "download CodeGen-2B-multi and Qwen2.5-Coder-7B-Instruct into the shared HF cache; toolchains present",
     "internet": true, "resources": {"gpus": "h100_1g.10gb:1", "cpus": 4, "mem": "16G", "time": "02:00:00"},
     "steps": [
       {"name": "check_gpu", "builtin": "check_gpu", "always": true},
       {"name": "toolchains", "cmd": "mkdir -p {RESULTS}/setup && (javac -version; java -version; node --version; g++ --version | head -1) > {RESULTS}/setup/toolchains.txt 2>&1", "critical": true},
       {"name": "models", "cmd": "HF_HUB_OFFLINE=0 python -c \"from huggingface_hub import snapshot_download as s; [print(s(m)) for m in ('Salesforce/codegen-2B-multi', 'Qwen/Qwen2.5-Coder-7B-Instruct')]\"", "critical": true}
     ]},
    {"name": "main", "description": "per model x language: nominal, partial and the 6 format perturbations x 5 seeds; authors' generator and pass-status scripts",
     "depends": [{"stage": "setup", "type": "afterok"}],
     "matrix": {"model": ["qwencoder", "codegen2bmulti"], "lang": ["java", "cpp", "js"]},
     "resources": {"gpus": "h100_3g.40gb:1", "cpus": 4, "mem": "48G", "time": "24:00:00", "requeue": true},
     "env_note": "HF offline in jobs",
     "steps": [
       {"name": "prepare", "cmd": "[ -d {RESULTS}/work/{model}_{lang}/run_code ] || python {HPC}/glue_robust.py prepare {RESULTS}/work/{model}_{lang} {model} {lang}", "produces": ["work/{model}_{lang}/run_code/calculate_pass_status.py"]},
       {"name": "generate", "cmd": "HF_HUB_OFFLINE=1 MAX_FORMAT_FILES={MAX_FORMAT_FILES} python {HPC}/glue_robust.py generate {RESULTS}/work/{model}_{lang} {model} {lang}", "produces": ["work/{model}_{lang}/datasets/{model}/generated_pass5_1/{lang}/nominal/f_s0.jsonl"],
        "progress": {"file": "work/{model}_{lang}/datasets/{model}/generated_pass5_1/{lang}/nominal/f_s0.jsonl", "expected": "164"}},
       {"name": "evaluate", "cmd": "cd {RESULTS}/work/{model}_{lang}/run_code && mkdir -p ../testing_{lang} && python calculate_pass_status.py {model} {lang} testing_{lang}"}
     ]},
    {"name": "collect", "depends": [{"stage": "main", "type": "afterany"}],
     "resources": {"gpus": "h100_1g.10gb:1", "cpus": 2, "mem": "16G", "time": "01:00:00"},
     "steps": [
       {"name": "compare", "cmd": "python {HPC}/compare.py {RESULTS} {HPC}/reported.csv", "always": true},
       {"name": "collect", "builtin": "collect", "always": true}
     ]}
  ],
  "results": {"tables": [{"name": "comparison", "glob": "compare/comparison.csv"}], "copy": ["compare/*", "setup/*"], "archive": ["work"]}
}
